# Copy this file to run/.amazon.env and paste the cookie of a request your signed-in
# music.amazon.com player sends to gql.music.amazon.com, on one line (see
# importer/AMAZON_MUSIC.md). It is your amazon.com login, shopping included: do not share
# run/.amazon.env, and put paste_here back when the import is done.
AMAZON_MUSIC_COOKIE=paste_here
