# Copy this file to run/.amazon.env and paste the authorization value of a request your
# signed-in music.amazon.com player sends to gql.music.amazon.dev, on one line (see
# importer/AMAZON_MUSIC.md). It starts with "AmznMusic " and lasts about an hour. Do not
# share run/.amazon.env, and put paste_here back when the import is done.
AMAZON_MUSIC_AUTH=paste_here
