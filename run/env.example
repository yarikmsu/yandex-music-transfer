# Copy this file to run/.env and paste the token from the browser redirect:
# the part after "access_token=" up to "&" (see README.md).
# Do not share run/.env. Add USER_2_NAME / USER_2_TOKEN for a second account.
# The name only labels the output files, e.g. out/liked_tracks_me.csv.
USER_1_NAME=me
USER_1_TOKEN=your_token_here
