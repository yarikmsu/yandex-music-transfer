# Copy this file to run/.ytmusic.env and paste the cookie of your signed-in
# music.youtube.com session on one line (see importer/YOUTUBE_MUSIC.md). It is a full
# Google login: do not share run/.ytmusic.env, and put paste_here back when the import is done.
YTMUSIC_COOKIE=paste_here
# Which signed-in Google account to use (the x-goog-authuser header); 0 unless the
# browser was signed in to several accounts
YTMUSIC_AUTHUSER=0
